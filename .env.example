# Rathnone gateway — deployment configuration (fail-closed env knobs)
#
# Copy to `.env` (or export into the environment) and adjust to your risk
# tolerance. The service REFUSES to sign anything that violates these bounds,
# and a malformed value raises at import time rather than silently disabling
# a guard. See docs/13-SECURITY-THREAT-MODEL.md and docs/17-P0-SECURITY-REMEDIATION.md.
#
# --- CONTROL-PLANE AUTH (ADR 17: enable in production) -----------------------
# Gate all control-plane endpoints (tenant provisioning, /safety/halt+resume,
# evidence/audit/meter/reconciliation reads) behind a static API key.
# ENFORCE_AUTH=0 => open (dev/local-first). ENFORCE_AUTH=1 => 401 without key.
RATHNONE_ENFORCE_AUTH=1
RATHNONE_API_KEY=change-me-to-a-long-random-shared-secret

# --- LIVE-TRACK KILLSWITCH BOUNDS (set BOTH in production) -------------------

# V4: refuse to sign any settlement transfer above this many wei.
# Unset = NO ceiling (do not run like this in production).
# "0" bans all settlements. This is the single most important production knob.
# Example: ~0.5 ETH per settlement.
RATHNONE_MAX_SETTLEMENT_VALUE_WEI=500000000000000000

# V1: max live signatures per sliding window (velocity guard).
# Default when unset is 10**12 (effectively unlimited). Set strict in prod.
RATHNONE_LIVE_RATE_MAX=100

# --- DURABLE REPLAY/NONCE REGISTRY (P1) --------------------------------------
# File path for the SQLite-backed replay/nonce/cross-tenant registry so the
# invariants survive a restart. Unset = in-memory (process-local, hermetic;
# fine for a single ephemeral process, NOT for durable multi-tenant prod).
# RATHNONE_LEDGER_DB=/var/lib/rathnone/ledger.db

# --- SERVICE ----------------------------------------------------------------

# Bind address for uvicorn. Keep on localhost behind an auth proxy unless the
# operator console is the only client and the network is trusted.
RATHNONE_HOST=0.0.0.0
RATHNONE_PORT=8765
